# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# --- Gemini: quiz generation, RAG answers, domain tagging ---
# Free tier, no credit card: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AI...
GEMINI_MODEL=gemini-2.5-flash

# --- Pinecone: vector database for embeddings ---
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=gyan-sarthi-content
PINECONE_EMBEDDING_MODEL=multilingual-e5-large
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
