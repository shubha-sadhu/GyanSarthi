# Copy this file to .env and adjust if needed.

PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# MongoDB connection string for the user/login database.
# Local: mongodb://127.0.0.1:27017/gyan_sarthi
# Atlas (free tier): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gyan_sarthi
MONGODB_URI=mongodb://127.0.0.1:27017/gyan_sarthi

# Anyone who registers with this code in the "Admin code" field becomes an
# admin (can ingest content, view the org heat-map). Set this to something
# private, share it only with whoever should be an admin, then consider
# rotating/removing it once your admins are set up.
ADMIN_SIGNUP_CODE=change-this-too

# Where the Python FastAPI backend (RAG / vector store / competency engine) is running
PYTHON_API_URL=http://127.0.0.1:8000

# Where the React frontend is served from, for CORS
CORS_ORIGIN=http://localhost:5173
